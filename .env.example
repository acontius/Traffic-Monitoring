# Copy to .env and adjust. All settings are read with the TCMS_ prefix
# (see Backend/app/core/config.py).

TCMS_DB_DSN=postgresql://acontius:1234@db:5432/traffic_monitoring

TCMS_JWT_SECRET=change-me-in-production
TCMS_ACCESS_TOKEN_EXPIRES_MINUTES=15
TCMS_REFRESH_TOKEN_EXPIRES_DAYS=7

TCMS_CORS_ORIGINS=["http://localhost:4200"]

TCMS_DEVICE_SHARED_TOKEN=change-me-device-token

TCMS_RECONSTRUCTION_SCAN_INTERVAL_SECONDS=60
TCMS_RECONSTRUCTION_GRACE_PERIODS=1

# Point these at the bundled mock (Backend/mock_external/server.py) for
# local dev/testing; swap for the real endpoints in production.
TCMS_ROAD_AUTHORITY_WEBHOOK_URL=http://mock-external:9100/mock-road-authority
TCMS_ROAD_AUTHORITY_API_KEY=
TCMS_FORWARDING_WORKER_INTERVAL_SECONDS=15
TCMS_FORWARDING_MAX_ATTEMPTS=8
TCMS_FORWARDING_BACKOFF_BASE_SECONDS=10

TCMS_SMS_GATEWAY_URL=http://mock-external:9100/mock-sms
TCMS_SMS_GATEWAY_API_KEY=
TCMS_SMS_RECIPIENTS=[]

# Device simulator
TCMS_HUB_WS_URL=ws://app:8000/ws/ingest
TCMS_DEVICE_TOKEN=change-me-device-token
TCMS_SIMULATOR_INTERVAL_SECONDS=300

# Admin bootstrap (Backend/scripts/create_admin.py)
TCMS_ADMIN_USERNAME=admin
TCMS_ADMIN_PASSWORD=change-me
